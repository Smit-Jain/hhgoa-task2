# Groq API for ultra-fast LLM inference (< 200ms)
GROQ_API_KEY="your_groq_api_key_here"

# Speech-To-Text APIs (Fill in at least one)
# 1. Sarvam API (Optimized for Indic contexts)
SARVAM_API_KEY="your_sarvam_api_key_here"

# 2. ElevenLabs API (Global low latency)
ELEVENLABS_API_KEY="your_elevenlabs_api_key_here"

# STT Provider Selection (sarvam | elevenlabs)
STT_PROVIDER=sarvam

# Qdrant Cloud Vector DB (Required)
QDRANT_URL="your_qdrant_cloud_url_here"
QDRANT_API_KEY="your_qdrant_api_key_here"
